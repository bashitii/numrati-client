# Copy to .env (optional). Everything here stays on your machine.

# Gemini API key for the "Sanadak" assistant (aistudio.google.com/apikey). Used only by the dev server.
GEMINI_API_KEY=

# Where the API lives. Leave empty in development (Vite forwards /api to localhost:4000).
# For a deployed site, e.g. https://numrati-api.onrender.com/api
VITE_API_URL=
